  "project": {
    "title": "PROJECT ZONE",
    "tagline": "Independent Unity 6 open-zone FPS RPG",
    "phase": "Technical Foundation & Asset Readiness (M5.5)",
    "description": "PROJECT ZONE is an independent Unity 6 URP open-zone FPS RPG. Explore a dangerous exclusion zone, fight hostiles, scavenge gear, complete contracts, and return to safety. Performance-first: 120–150+ FPS typical, 100 FPS floor on reference hardware. Built with HQ FPS Weapons 2.0 and Emerald AI 2026, bridged by Project Zone adapters.",
    "engine": "Unity 6 · URP · C#"
  },
